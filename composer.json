{
  "name": "plugin/yard-warden",
  "description": "Enhanced password and login security for WordPress.",
  "homepage": "https://www.yard.nl",
  "type": "wordpress-plugin",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "composer",
      "url": "https://satis.yard.nl"
    }
  ],
  "require": {
    "php": ">=7.4",
    "yard/logger": "^1.0",
    "bjeavons/zxcvbn-php": "^1.3"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "yard/php-cs-fixer-rules": "^1.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "johnbillion/wp-compat": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "Yard\\Warden\\": "./src"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "composer dump-autoload"
    ],
    "post-update-cmd": [
      "composer dump-autoload"
    ],
    "format": " ./vendor/bin/php-cs-fixer fix",
    "analyse": "vendor/bin/phpstan analyse --debug --memory-limit 1G"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true,
      "php-http/discovery": true
    }
  }
}
